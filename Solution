public class Solution {
    
    public String longestPalindrome(String s) {
        if (s == null || s.length() < 1) {
            return "";
        }
        
        int start = 0;
        int end = 0;
        
        for (int i = 0; i < s.length(); i++) {
            // Check for odd-length palindromes (center is i)
            int len1 = expandAroundCenter(s, i, i);
            // Check for even-length palindromes (center is between i and i + 1)
            int len2 = expandAroundCenter(s, i, i + 1);
            
            int maxLen = Math.max(len1, len2);
            
            // If we found a longer palindrome, update our start and end pointers
            if (maxLen > end - start) {
                start = i - (maxLen - 1) / 2;
                end = i + maxLen / 2;
            }
        }
        
        return s.substring(start, end + 1);
    }
    
    private int expandAroundCenter(String s, int left, int right) {
        // Expand outwards as long as bounds are valid and characters match
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        // Return the length of the palindrome found
        return right - left - 1;
    }

    // Main method for testing
    public static void main(String[] args) {
        Solution solver = new Solution();

        // Test Case 1
        String s1 = "babad";
        System.out.println("Input: s = \"" + s1 + "\"");
        System.out.println("Output: \"" + solver.longestPalindrome(s1) + "\""); // Expected: "bab" or "aba"
        System.out.println();

        // Test Case 2
        String s2 = "cbbd";
        System.out.println("Input: s = \"" + s2 + "\"");
        System.out.println("Output: \"" + solver.longestPalindrome(s2) + "\""); // Expected: "bb"
    }
}
